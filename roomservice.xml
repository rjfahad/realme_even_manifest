<?xml version="1.0" encoding="UTF-8"?>
<manifest>

    <remote name="rl" fetch="https://github.com/rjfahad/" />
    <remote name="clangsantoni" fetch="https://gitlab.com/clangsantoni/" />

    <!-- Remove vendor/rising and vendor/lineage from main manifest to redefine -->
    <remove-project name="android_vendor_rising" />
    <remove-project name="android_vendor_lineage" />

    <!-- Remove broken forgejo vendor/gms -->
    <remove-project name="vendor_gms" />

    <!-- Device tree (rjfahad fork) -->
    <project path="device/realme/even" name="device_realme_even_rui4" remote="rl" revision="risingos-a16" />

    <!-- Vendor blobs (Badmaneers RUI4) -->
    <project path="vendor/realme/even" name="vendor_realme_even_rui4" remote="rl" revision="risingos-a16" />

    <!-- Kernel (Badmaneers Zenium) -->
    <project path="kernel/realme/even" name="zenium_realme_even" remote="rl" revision="rui4-clean" />

    <!-- Toolchain (zyc clang 14) -->
    <project path="prebuilts/clang/host/linux-x86/mylitle-clang" name="zyc_clang" remote="clangsantoni" revision="14" />

    <!-- RisingOS vendor config -->
    <project path="vendor/rising" name="android_vendor_rising" remote="rising" revision="sixteen-qpr2" />

    <!-- RisingOS lineage vendor -->
    <project path="vendor/lineage" name="android_vendor_lineage" remote="rising" revision="sixteen-qpr2" />

    <!-- RealmeParts (rjfahad fork: FPS overlay via SurfaceFlinger) -->
    <project path="packages/apps/RealmeParts" name="android_packages_apps_RealmeParts" remote="rl" revision="lineage-20-fps" />

</manifest>
